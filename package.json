{
  "name": "changesmith",
  "version": "2.0.0",
  "description": "AI-powered commit message generator and code reviewer with multi-agent capabilities, learning system, and regression detection",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cs": "./dist/cli.js",
    "changesmith": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "QUICKSTART.md"
  ],
  "scripts": {
    "build": "rollup -c ./rollup.config.js",
    "dbgstart": "node --enable-source-maps dist/index.js",
    "start": "node dist/index.js",
    "test": "echo \"No tests yet\"",
    "lint": "echo \"No linter configured\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "git",
    "commit",
    "message",
    "review",
    "pr",
    "llm",
    "sre",
    "changesmith",
    "conventional-commits",
    "code-review",
    "ai",
    "claude",
    "anthropic"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/changesmith.git"
  },
  "homepage": "https://github.com/your-org/changesmith#readme",
  "bugs": {
    "url": "https://github.com/your-org/changesmith/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@types/node": "^22.9.0",
    "esbuild": "^0.25.11",
    "rollup": "^2.79.2",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-sourcemaps": "^0.6.3",
    "rollup-plugin-typescript-paths": "^1.5.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@smythos/sdk": "^1.3.1",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "glob": "^11.1.0",
    "ora": "^8.2.0"
  }
}
